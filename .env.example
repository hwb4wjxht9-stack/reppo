# Robinhood API credential key, from web classic -> crypto account settings -> API keys.
ROBINHOOD_API_KEY=

# Base64 Ed25519 private key (32-byte seed) whose public key is registered with the
# credential above. Generate a pair with `npm run keygen`. Never commit this value.
ROBINHOOD_PRIVATE_KEY=

# Optional overrides.
# ROBINHOOD_BASE_URL=https://trading.robinhood.com
# TRANSPORT=stdio          # or "http"
# HOST=127.0.0.1           # http transport only
# PORT=3000                # http transport only
# ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
